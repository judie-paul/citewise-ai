# OpenAI (optional) - enables AI query generation and essay analysis.
OPENAI_API_KEY=
# Defaults to gpt-4o-mini when empty.
OPENAI_MODEL=

PORT=8080
DATABASE_PATH=./data/citewise.db
MAX_UPLOAD_MB=10
# Directory for temporary upload files. Empty = OS temp directory.
TEMP_DIR=

# Crossref polite pool contact address (recommended).
CROSSREF_MAILTO=
# OpenAlex API key (recommended; free at https://openalex.org/settings/api).
OPENALEX_API_KEY=
